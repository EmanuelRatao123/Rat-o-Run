# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Secret Admin Account Provisioning (never commit real values)
ADMIN_INITIAL_USERNAME=
ADMIN_INITIAL_PASSWORD=

# Second Admin Account ("Samuka" — password configured exclusively via server env, never commit real values)
ADMIN_SAMUKA_USERNAME=Samuka
ADMIN_SAMUKA_PASSWORD=

# Session & Match Anti-Cheat Signing Key (random 32+ bytes hex/base64)
SESSION_SECRET=

# Neon PostgreSQL Connection String (used automatically in Vercel / production)
DATABASE_URL=

# WebRTC Voice Calls (optional STUN/TURN configuration — keep TURN credentials secret on server)
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
CALL_INVITE_TIMEOUT_SEC=30


