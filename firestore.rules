rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'elisangelaemauriciolima@gmail.com'
      );
    }

    function isValidSkin(skinId) {
      return skinId is string && skinId in [
        'ratao', 'capivara', 'macaco', 'neymar_2011', 'lamine_yamal',
        'tartaruga', 'cachorro', 'superman', 'homem_de_ferro', 'galo_doido'
      ];
    }

    function isValidMap(mapId) {
      return mapId is string && mapId in ['brasil', 'tokyo', 'futebol', 'capivara'];
    }

    function isValidUserPublic(data, userId) {
      return data.keys().hasAll(['uid', 'nickname', 'equippedSkin', 'bestNoCoinTimeMs', 'totalMatches', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'uid', 'nickname', 'equippedSkin', 'unlockedSkins',
          'bestNoCoinTimeMs', 'bestDistance', 'bestScore',
          'totalMatches', 'totalCoins', 'favoriteSkin',
          'createdAt', 'updatedAt'
        ])
        && data.uid is string && data.uid == userId && data.uid.size() <= 128
        && data.nickname is string && data.nickname.size() >= 2 && data.nickname.size() <= 24
        && isValidSkin(data.equippedSkin)
        && (!('unlockedSkins' in data) || (data.unlockedSkins is list && data.unlockedSkins.size() <= 20 && (data.unlockedSkins.size() == 0 || data.unlockedSkins[0] is string)))
        && data.bestNoCoinTimeMs is number && data.bestNoCoinTimeMs >= 0 && data.bestNoCoinTimeMs <= 3600000
        && (!('bestDistance' in data) || (data.bestDistance is number && data.bestDistance >= 0 && data.bestDistance <= 1000000))
        && (!('bestScore' in data) || (data.bestScore is number && data.bestScore >= 0 && data.bestScore <= 100000000))
        && data.totalMatches is number && data.totalMatches >= 0 && data.totalMatches <= 1000000
        && (!('totalCoins' in data) || (data.totalCoins is number && data.totalCoins >= 0 && data.totalCoins <= 100000000))
        && (!('favoriteSkin' in data) || isValidSkin(data.favoriteSkin))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserPrivate(data, userId) {
      return data.keys().hasAll(['uid', 'role', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'role', 'createdAt'])
        && data.uid is string && data.uid == userId && data.uid.size() <= 128
        && (!('email' in data) || (data.email is string && data.email.size() <= 256))
        && data.role is string && data.role in ['player', 'admin']
        && data.createdAt is timestamp;
    }

    function isValidLeaderboardEntry(data, userId) {
      return data.keys().hasAll(['uid', 'nickname', 'skinId', 'mapId', 'noCoinTimeMs', 'achievedAt'])
        && data.keys().hasOnly(['uid', 'nickname', 'skinId', 'mapId', 'noCoinTimeMs', 'distance', 'achievedAt'])
        && data.uid is string && data.uid == userId && data.uid.size() <= 128
        && data.nickname is string && data.nickname.size() >= 2 && data.nickname.size() <= 24
        && isValidSkin(data.skinId)
        && isValidMap(data.mapId)
        && data.noCoinTimeMs is number && data.noCoinTimeMs >= 0 && data.noCoinTimeMs <= 3600000
        && (!('distance' in data) || (data.distance is number && data.distance >= 0 && data.distance <= 1000000))
        && data.achievedAt is timestamp;
    }

    function isValidMatchRecord(data) {
      return data.keys().hasAll(['uid', 'nickname', 'skinId', 'mapId', 'noCoinTimeMs', 'coins', 'distance', 'score', 'durationMs', 'createdAt'])
        && data.keys().hasOnly(['uid', 'nickname', 'skinId', 'mapId', 'noCoinTimeMs', 'coins', 'distance', 'score', 'durationMs', 'createdAt'])
        && data.uid is string && data.uid == request.auth.uid && data.uid.size() <= 128
        && data.nickname is string && data.nickname.size() >= 2 && data.nickname.size() <= 24
        && isValidSkin(data.skinId)
        && isValidMap(data.mapId)
        && data.noCoinTimeMs is number && data.noCoinTimeMs >= 0 && data.noCoinTimeMs <= 3600000
        && data.coins is number && data.coins >= 0 && data.coins <= 100000
        && data.distance is number && data.distance >= 0 && data.distance <= 1000000
        && data.score is number && data.score >= 0 && data.score <= 100000000
        && data.durationMs is number && data.durationMs >= 0 && data.durationMs <= 3600000
        && data.noCoinTimeMs <= data.durationMs + 500
        && data.createdAt is timestamp;
    }

    function isValidGlobalMessage(data) {
      return data.keys().hasAll(['title', 'content', 'authorUid', 'active', 'expiresAt', 'createdAt'])
        && data.keys().hasOnly(['title', 'content', 'authorUid', 'active', 'expiresAt', 'createdAt'])
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 80
        && data.content is string && data.content.size() >= 1 && data.content.size() <= 400
        && data.authorUid is string && data.authorUid.size() <= 128
        && data.active is bool
        && data.expiresAt is timestamp
        && data.createdAt is timestamp;
    }

    function isValidPoll(data) {
      return data.keys().hasAll(['title', 'options', 'authorUid', 'active', 'expiresAt', 'createdAt'])
        && data.keys().hasOnly(['title', 'options', 'authorUid', 'active', 'expiresAt', 'createdAt'])
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && data.options is list && data.options.size() >= 2 && data.options.size() <= 6 && data.options[0] is string
        && data.authorUid is string && data.authorUid.size() <= 128
        && data.active is bool
        && data.expiresAt is timestamp
        && data.createdAt is timestamp;
    }

    function isValidVote(data, pollId, voteId) {
      return data.keys().hasAll(['pollId', 'uid', 'optionIndex', 'createdAt'])
        && data.keys().hasOnly(['pollId', 'uid', 'optionIndex', 'createdAt'])
        && data.pollId is string && data.pollId == pollId && data.pollId.size() <= 128
        && data.uid is string && data.uid == request.auth.uid && data.uid == voteId && data.uid.size() <= 128
        && data.optionIndex is number && data.optionIndex >= 0 && data.optionIndex <= 5
        && data.createdAt is timestamp;
    }

    function isValidGift(data) {
      return data.keys().hasAll(['targetUid', 'targetNickname', 'skinId', 'grantedByUid', 'createdAt'])
        && data.keys().hasOnly(['targetUid', 'targetNickname', 'skinId', 'grantedByUid', 'createdAt', 'seen'])
        && data.targetUid is string && data.targetUid.size() >= 1 && data.targetUid.size() <= 128
        && data.targetNickname is string && data.targetNickname.size() >= 2 && data.targetNickname.size() <= 24
        && isValidSkin(data.skinId)
        && data.grantedByUid is string && data.grantedByUid.size() <= 128
        && (!('seen' in data) || data.seen is bool)
        && data.createdAt is timestamp;
    }

    function isValidAdminLog(data) {
      return data.keys().hasAll(['adminUid', 'action', 'details', 'createdAt'])
        && data.keys().hasOnly(['adminUid', 'action', 'details', 'createdAt'])
        && data.adminUid is string && data.adminUid.size() <= 128
        && data.action is string && data.action.size() >= 1 && data.action.size() <= 64
        && data.details is string && data.details.size() >= 1 && data.details.size() <= 500
        && data.createdAt is timestamp;
    }

    function isValidGameSettings(data) {
      return data.keys().hasAll(['featuredMap', 'updatedAt'])
        && data.keys().hasOnly(['featuredMap', 'updatedAt'])
        && isValidMap(data.featuredMap)
        && data.updatedAt is timestamp;
    }

    // Connection check doc
    match /test/connection {
      allow get: if true;
    }

    // Admins lookup collection
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (isOwner(adminId) || isAdmin());
      allow write: if false;
    }

    // Public User Profiles
    match /users/{userId} {
      allow get: if isValidId(userId) && isSignedIn();
      allow list: if isSignedIn() && resource.data.uid is string;
      allow create: if isValidId(userId) && isOwner(userId)
        && isValidUserPublic(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId) && isValidUserPublic(incoming(), userId) && (
        isAdmin() || (
          isOwner(userId)
          && incoming().uid == existing().uid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'nickname', 'equippedSkin', 'bestNoCoinTimeMs', 'bestDistance',
            'bestScore', 'totalMatches', 'totalCoins', 'favoriteSkin', 'updatedAt'
          ])
        )
      );
      allow delete: if isValidId(userId) && isAdmin();

      // Private PII subcollection
      match /private/{docId} {
        allow get: if isValidId(docId) && (isOwner(userId) || isAdmin());
        allow create: if isValidId(docId) && isOwner(userId)
          && isValidUserPrivate(incoming(), userId)
          && incoming().role == 'player'
          && incoming().createdAt == request.time;
        allow update: if isValidId(docId) && isAdmin() && isValidUserPrivate(incoming(), userId);
        allow delete: if false;
      }
    }

    // Global Sem Pegar Moedas Leaderboard (publicly readable)
    match /leaderboard/{userId} {
      allow get: if isValidId(userId);
      allow list: if resource.data.noCoinTimeMs is number;
      allow create: if isValidId(userId) && isOwner(userId)
        && isValidLeaderboardEntry(incoming(), userId)
        && incoming().achievedAt == request.time;
      allow update: if isValidId(userId) && isValidLeaderboardEntry(incoming(), userId) && (
        isAdmin() || (
          isOwner(userId)
          && incoming().uid == existing().uid
          && incoming().noCoinTimeMs >= existing().noCoinTimeMs
          && incoming().achievedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'nickname', 'skinId', 'mapId', 'noCoinTimeMs', 'distance', 'achievedAt'
          ])
        )
      );
      allow delete: if isValidId(userId) && isAdmin();
    }

    // Matches history
    match /matches/{matchId} {
      allow get: if isValidId(matchId) && isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isValidId(matchId) && isVerifiedUser()
        && isValidMatchRecord(incoming())
        && incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    // Global Messages (admin writes, signed-in/public reads)
    match /globalMessages/{messageId} {
      allow get: if isValidId(messageId);
      allow list: if resource.data.active is bool;
      allow create: if isValidId(messageId) && isAdmin()
        && isValidGlobalMessage(incoming())
        && incoming().createdAt == request.time;
      allow update: if isValidId(messageId) && isAdmin()
        && isValidGlobalMessage(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'content', 'active', 'expiresAt']);
      allow delete: if isValidId(messageId) && isAdmin();
    }

    // Global Polls
    match /polls/{pollId} {
      allow get: if isValidId(pollId);
      allow list: if resource.data.title is string;
      allow create: if isValidId(pollId) && isAdmin()
        && isValidPoll(incoming())
        && incoming().createdAt == request.time;
      allow update: if isValidId(pollId) && isAdmin()
        && isValidPoll(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['active', 'expiresAt']);
      allow delete: if isValidId(pollId) && isAdmin();

      match /votes/{voteId} {
        allow get: if isValidId(voteId) && isSignedIn();
        allow list: if isSignedIn() && resource.data.pollId == pollId;
        allow create: if isValidId(voteId) && isVerifiedUser()
          && isValidVote(incoming(), pollId, voteId)
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/polls/$(pollId))
          && get(/databases/$(database)/documents/polls/$(pollId)).data.active == true;
        allow update, delete: if false;
      }
    }

    // Skin Gifts
    match /gifts/{giftId} {
      allow get: if isValidId(giftId) && isSignedIn() && (resource.data.targetUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.targetUid == request.auth.uid || isAdmin());
      allow create: if isValidId(giftId) && isAdmin()
        && isValidGift(incoming())
        && incoming().createdAt == request.time;
      allow update: if isValidId(giftId) && isValidGift(incoming()) && (
        isAdmin() || (
          isOwner(existing().targetUid)
          && incoming().diff(existing()).affectedKeys().hasOnly(['seen'])
        )
      );
      allow delete: if false;
    }

    // Admin Logs
    match /adminLogs/{logId} {
      allow get: if isValidId(logId) && isAdmin();
      allow list: if isAdmin() && resource.data.adminUid is string;
      allow create: if isValidId(logId) && isAdmin()
        && isValidAdminLog(incoming())
        && incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    // Global Game Settings
    match /gameSettings/{settingId} {
      allow get: if isValidId(settingId);
      allow create, update: if isValidId(settingId) && isAdmin()
        && isValidGameSettings(incoming())
        && incoming().updatedAt == request.time;
      allow delete: if false;
    }
  }
}
